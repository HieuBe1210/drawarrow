.separator {
    height: 1px;
    background-color: rgb(0, 0, 0);
    width: 100%;
}

.bottom-container {
    flex-direction: row;
    padding-top: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    flex-shrink: 0;
}

.bottom-container Button {
    min-width: 60px;
    flex-shrink: 0;
}

.window-title {
    -unity-font-style: bold;
    font-size: 13px;
    padding-left: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.description {
    white-space: normal;
    margin-top: 6px;
    padding: 0;
}

.content-container {
    flex-direction: column;
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.message {
    white-space: normal;
    padding: 0;
    margin: 0;
}
